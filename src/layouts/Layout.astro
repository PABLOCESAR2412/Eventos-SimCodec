---
import '../styles/global.css';
import type { Locale } from '../../shared/domain';
import { translator, localeForPath } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
}

const { title, description, locale = localeForPath(Astro.url.pathname) } = Astro.props;
const t = translator(locale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload Critical Assets -->
    <link rel="preload" as="image" href="/logos/logo_color.png" media="(prefers-color-scheme: light)" />
    <link rel="preload" as="image" href="/logos/logo_blanco.png" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- SEO & OpenGraph Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#F8F9FA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="SimCodec Events" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Schema.org JSON-LD (WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'SimCodec Events', url: Astro.url.origin + '/', description, inLanguage: locale }).replace(/</g, '\\u003c')}></script>
    
    <!-- SimCodec Fonts: Inter + JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Theme Script to avoid FOUC -->
    <script is:inline>
      (() => {
        let savedTheme;
        try { savedTheme = localStorage.getItem('theme'); } catch { /* Storage may be blocked. */ }
        const dark = savedTheme === 'dark' ||
          (savedTheme !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.getElementById('theme-color')?.setAttribute('content', dark ? '#0A0A0C' : '#F8F9FA');
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-color)] text-[var(--text-color)] font-sans antialiased selection:bg-[var(--color-sim-action)] selection:text-white transition-colors duration-300">

    <!-- Background Pattern -->
    <div class="fixed inset-0 pointer-events-none z-[-1] opacity-40 dark:opacity-20 transition-opacity duration-300">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    </div>
    
    <!-- Top Nav con Logo -->
    <nav class="fixed top-0 left-0 right-0 z-[100] flex items-center justify-between px-6 py-4 bg-white/90 dark:bg-[#0A0A0C]/90 backdrop-blur-md border-b border-[var(--border-color)] transition-colors duration-300">
      <div class="flex items-center gap-3">
        <!-- SimCodec Logo -->
        <a href={locale === 'en' ? '/en/' : '/'} class="relative block w-[140px] h-[32px]" aria-label="SimCodec Home">
          <img src="/logos/logo_color.png" alt="SimCodec Logo" class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 opacity-100 dark:opacity-0" />
          <img src="/logos/logo_blanco.png" alt="SimCodec Logo" class="absolute inset-0 w-full h-full object-contain transition-opacity duration-300 opacity-0 dark:opacity-100" />
        </a>
      </div>
      <div class="flex items-center gap-4">
        <a href={locale === 'en' ? '/' : '/en/'} hreflang={locale === 'en' ? 'es' : 'en'} class="min-h-11 px-2 flex items-center text-sm font-semibold focus-visible:outline-2 focus-visible:outline-[var(--color-sim-action)]">{locale === 'en' ? 'Español' : 'English'}</a>
        <button id="theme-toggle" aria-label={t('Cambiar tema de color')} class="p-2 rounded-lg text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white bg-gray-100 dark:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-[var(--color-sim-action)] transition-colors">
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        </button>
      </div>
    </nav>
    
    <div class="pt-24">
      <slot />
    </div>

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
      });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      // Theme Toggle Logic
      const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
      const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
      const themeToggleBtn = document.getElementById('theme-toggle') as HTMLButtonElement | null;

      if (themeToggleDarkIcon && themeToggleLightIcon && themeToggleBtn) {
        const root = document.documentElement;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const syncThemeControls = () => {
          const dark = root.classList.contains('dark');
          themeToggleDarkIcon.classList.toggle('hidden', dark);
          themeToggleLightIcon.classList.toggle('hidden', !dark);
          themeToggleBtn.setAttribute('aria-pressed', String(dark));
          themeToggleBtn.title = document.documentElement.lang === 'en' ? (dark ? 'Switch to light theme' : 'Switch to dark theme') : (dark ? 'Activar tema claro' : 'Activar tema oscuro');
          document.getElementById('theme-color')?.setAttribute('content', dark ? '#0A0A0C' : '#F8F9FA');
        };
        syncThemeControls();
        const settleThemeStyles = () => new Promise<void>(resolve => {
          requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
        });

        themeToggleBtn.addEventListener('click', async () => {
          if (themeToggleBtn.disabled) return;
          const dark = !root.classList.contains('dark');
          const applyTheme = () => {
            root.classList.toggle('dark', dark);
            syncThemeControls();
            try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* Theme still works without storage. */ }
          };

          themeToggleBtn.disabled = true;
          root.setAttribute('data-theme-switching', '');
          try {
            if (typeof document.startViewTransition === 'function' && !reducedMotion.matches) {
              const transition = document.startViewTransition(applyTheme);
              // A hidden document can skip snapshots while still applying the theme.
              transition.ready.catch(() => {});
              await transition.finished;
            } else {
              // Older browsers and reduced motion use one immediate, synchronized change.
              applyTheme();
              await settleThemeStyles();
            }
          } catch {
            applyTheme();
            await settleThemeStyles();
          } finally {
            // Flush the final colors before restoring component hover/modal transitions.
            void root.offsetWidth;
            root.removeAttribute('data-theme-switching');
            themeToggleBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
