---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import EventCard from '../components/EventCard.astro';
import EventModal from '../components/EventModal.astro';
import { translator, localeForPath } from '../lib/i18n';
import { catalogPage, pageOffset, priceInfo } from '../../shared/domain';
const locale = localeForPath(Astro.url.pathname), t = translator(locale);
import { getCatalogData } from '../lib/catalog-data';
import { catalogArgs } from '../lib/catalog';
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600');
const args = catalogArgs(Astro.url.searchParams);
const isCourseView = args.kind === 'COURSE';
const viewUrl = (courses: boolean) => {
  const url = new URL(Astro.url);
  url.searchParams.delete('cursor');
  if (courses) {
    url.searchParams.set('view', 'courses');
    url.searchParams.delete('date');
  } else {
    url.searchParams.delete('view');
  }
  url.searchParams.sort();
  return url.pathname + url.search;
};
let failure = '';
let result: Awaited<ReturnType<typeof loadCatalog>>;
async function loadCatalog() { return catalogPage(await getCatalogData(args.kind), args, args.paginationOpts.cursor, args.paginationOpts.numItems); }
try { pageOffset(args.paginationOpts.cursor, args.paginationOpts.numItems); result = await loadCatalog(); }
catch (error) {
  const invalid = String(error).includes('Invalid catalog cursor');
  Astro.response.status = invalid ? 400 : 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  failure = invalid ? t('La página ya no es válida. Vuelve al inicio de los resultados.') : t('Catálogo no disponible. Vuelve a intentar en un minuto.');
  result = { page: [], total: 0, isDone: true, continueCursor: '', previousCursor: null };
}
const events = result.page.map(e => ({
  id: e._id, title: e.title, description: e.description, url: e.registrationUrl,
  source: e.source, category: e.category, subcategory: e.subcategory,
  location: { city: e.city || (e.isVirtual ? 'Virtual' : 'Presencial'), isVirtual: e.isVirtual, address: e.address },
  date: { start: new Date(e.dateStart), end: e.dateEnd ? new Date(e.dateEnd) : undefined },
  kind: e.kind, isLive: false, isFree: e.isFree, price: e.price, priceStatus: e.priceStatus, priceAmount: e.priceAmount, priceCurrency: e.priceCurrency, imageUrl: e.imageUrl
}));
const nextUrl = new URL(Astro.url); nextUrl.searchParams.set('cursor', result.continueCursor);
const previousUrl = new URL(Astro.url);
if (result.previousCursor) previousUrl.searchParams.set('cursor', result.previousCursor); else previousUrl.searchParams.delete('cursor');
const resetUrl = new URL(Astro.url); resetUrl.searchParams.delete('cursor');

---

<Layout locale={locale}
  title={t('Eventos Tech Ecuador | Comunidad, Meetups y Conferencias')}
  description={t('Plataforma centralizada en tiempo real de eventos, meetups, hackathons y conferencias de tecnología en Ecuador.')}
>
  <!-- Hero Section SimCodec Branded -->
  <header class="relative pt-32 pb-20 px-6 lg:px-12 border-b border-[var(--border-color)] overflow-hidden bg-[var(--bg-color)] transition-colors duration-300">
    <!-- SimCodec Geometric Background (Minimalist) -->
    <div class="absolute inset-0 opacity-10 dark:opacity-20 pointer-events-none" style="background-image: radial-gradient(var(--color-sim-brand) 1px, transparent 1px); background-size: 24px 24px;"></div>

    <div class="max-w-[90rem] mx-auto relative z-10 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[var(--color-sim-brand)]/30 bg-[var(--color-sim-brand)]/5 mb-8">
        <span class="w-2 h-2 rounded-full bg-[var(--color-sim-brand)] animate-pulse shadow-[0_0_8px_var(--color-sim-brand)]"></span>
        <span class="text-xs font-bold text-[var(--color-sim-brand)] tracking-wide uppercase">SIMCODEC EVENT PLATFORM</span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[var(--text-color)] tracking-tight mb-6 leading-tight transition-colors duration-300">
        {t('Explora el futuro de la')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-sim-primary)] to-[var(--color-sim-brand)] dark:from-[var(--color-sim-brand)] dark:to-teal-300 ml-3 transition-colors duration-300">{t('tecnología en Ecuador')}</span><br />
        {t('y expande tus conocimientos')}
      </h1>

      <p class="text-lg md:text-xl text-gray-700 dark:text-gray-400 max-w-2xl font-medium dark:font-light mb-10 transition-colors duration-300">
        {t('Plataforma B2B de Eventos Tecnológicos. Centralizando innovación, conferencias y hackathons globales.')}
      </p>
    </div>
  </header>

  <main class="max-w-[90rem] mx-auto px-6 lg:px-12 py-12 flex flex-col lg:flex-row gap-10">
    <Sidebar />

    <div class="flex-grow min-w-0">
      <nav aria-label={t('Tipo de contenido')} class="flex flex-wrap gap-x-6 gap-y-2 border-b border-[var(--border-color)] mb-6">
        <a href={viewUrl(false)} aria-current={!isCourseView ? 'page' : undefined} class:list={['min-h-11 py-3 border-b-2 text-sm sm:text-base font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sim-action)]', !isCourseView ? 'border-[var(--color-sim-action)] text-blue-700 dark:text-blue-300' : 'border-transparent text-[var(--text-color)] hover:border-[var(--border-color)]']}>
          {t('Eventos con fecha')}
        </a>
        <a href={viewUrl(true)} aria-current={isCourseView ? 'page' : undefined} class:list={['min-h-11 py-3 border-b-2 text-sm sm:text-base font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sim-action)]', isCourseView ? 'border-[var(--color-sim-action)] text-blue-700 dark:text-blue-300' : 'border-transparent text-[var(--text-color)] hover:border-[var(--border-color)]']}>
          {t('Cursos a tu ritmo')}
        </a>
      </nav>
      <!-- Barra de Búsqueda Dinámica -->
      <div class="mb-10 bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl p-6 shadow-sm transition-colors duration-300">
        <div class="w-full relative flex items-center bg-white dark:bg-[#111827] border border-gray-200 dark:border-gray-800 rounded-xl focus-within:border-[var(--color-sim-action)] focus-within:ring-4 focus-within:ring-[var(--color-sim-action)]/20 transition-all duration-300 p-1.5">
          <svg class="w-5 h-5 ml-4 text-gray-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <input
            type="text"
            id="global-search"
            aria-label={isCourseView ? t('Buscar cursos') : t('Buscar eventos')}
            placeholder={isCourseView ? t('Busca cursos y pulsa Enter') : t('Busca eventos y pulsa Enter')} value={args.searchTerm}
            class="flex-1 min-w-0 bg-transparent border-none outline-none px-4 py-2.5 text-gray-900 dark:text-white placeholder-gray-500 text-base font-medium transition-colors duration-300"
          />
          <button id="clear-search" class="hidden bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white font-bold py-2.5 px-4 rounded-lg transition-colors duration-200 uppercase text-xs tracking-wider">
            {t('Borrar')}
          </button>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
        <h2 class="text-2xl font-bold text-[var(--text-color)] transition-colors duration-300">{isCourseView ? t('Cursos a tu ritmo') : t('Eventos con fecha')}</h2>
        <span id="results-count" class="text-sm font-medium text-gray-700 dark:text-gray-400 bg-gray-200 dark:bg-gray-800 px-3 py-1 rounded-full border border-gray-300 dark:border-[var(--border-color)] transition-colors duration-300">
          {t('Resultados')}: {events.length} / {result.total}
        </span>
      </div>

      {failure && <div role="alert" class="mb-6"><p>{failure}</p><a class="inline-block mt-3 underline underline-offset-4" href={resetUrl.pathname + resetUrl.search}>{t('Volver al inicio de los resultados')}</a></div>}
      {!failure && events.length === 0 && <p class="mb-6">{t('No hay coincidencias. Ajusta los filtros o la búsqueda.')}</p>}
      <div class="events-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 transition-opacity duration-300">
        {events.map((event) => (
          <div
            class="event-wrapper"
            data-city={event.location.city}
            data-category={event.category}
            data-subcategory={event.subcategory || ''}
            data-source={event.source}
            data-modality={event.location.isVirtual ? 'virtual' : 'presential'}
            data-cost={priceInfo(event).priceStatus.toLowerCase()}
            data-date={event.date.start.getTime()}
            data-search={`${event.title} ${event.description || ''} ${event.category} ${event.subcategory || ''} ${event.source}`.toLowerCase()}
          >
            <EventCard event={event} />
          </div>
        ))}
      </div>

      <!-- Pagination Controls -->
      <div id="pagination-container" class="flex flex-col md:flex-row items-center justify-between gap-4 mt-12 bg-white dark:bg-[#111827] border border-gray-200 dark:border-gray-800 rounded-2xl p-4 shadow-sm transition-colors duration-300">
        <div class="flex items-center gap-3">
          <label for="page-size" class="text-sm font-semibold text-gray-600 dark:text-gray-400 transition-colors duration-300">{t('Mostrar:')}</label>
          <select id="page-size" class="bg-gray-100 dark:bg-gray-800 border-none rounded-lg text-sm font-bold text-[var(--text-color)] py-2 px-3 cursor-pointer focus:ring-2 focus:ring-[var(--color-sim-action)] transition-colors duration-300">
            <option value="12" selected={args.paginationOpts.numItems === 12}>12</option>
            <option value="24" selected={args.paginationOpts.numItems === 24}>24</option>
            <option value="48" selected={args.paginationOpts.numItems === 48}>48</option>

          </select>
        </div>

        <div class="flex items-center gap-2">
          <a id="prev-page" href={args.paginationOpts.cursor ? previousUrl.pathname + previousUrl.search : undefined} aria-disabled={!args.paginationOpts.cursor} class="p-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 aria-disabled:opacity-50 aria-disabled:cursor-not-allowed transition-colors duration-300" aria-label={t('Página anterior')}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </a>

          <div id="page-numbers" class="flex items-center gap-1 mx-2">
            <span class="text-sm">{t('Esta página')}: {events.length}</span>
          </div>

          <a id="next-page" href={!result.isDone ? nextUrl.pathname + nextUrl.search : undefined} aria-disabled={result.isDone} class="p-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 aria-disabled:opacity-50 aria-disabled:cursor-not-allowed transition-colors duration-300" aria-label={t('Siguiente página')}>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <EventModal />
  </main>

</Layout>
