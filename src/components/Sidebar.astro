---
const cities = ['Quito', 'Guayaquil', 'Cuenca', 'Virtual'];
const categories = ['Eventos', 'Formación', 'Competencias', 'Emprendimiento', 'Financiamiento', 'Comunidad', 'Empleo'];

// Subcategorías / Temas
const topics = [
  'Conferencias', 'Congresos', 'Charlas', 'Meetups', 'Workshops', 'Seminarios', 'Ferias Tecnológicas', 'Ferias Empresariales', 'Networking', 'Webinars',
  'Cursos', 'Bootcamps', 'Diplomados', 'Certificaciones', 'Talleres', 'Programas de Capacitación',
  'Hackathons', 'Concursos', 'Olimpiadas', 'Competencias de IA', 'Competencias de Ciencia de Datos', 'Competencias de Programación',
  'Convocatorias', 'Incubadoras', 'Aceleradoras', 'Startup Programs', 'Demo Days', 'Pitch Competitions',
  'Becas', 'Grants', 'Fondos de Innovación', 'Capital Semilla', 'Fondos de Investigación',
  'Mentorías', 'Comunidades Tech', 'User Groups', 'Capítulos IEEE', 'Google Developer Groups', 'Women Techmakers',
  'Ferias de Empleo', 'Recruiting Events', 'Career Days', 'Tech Recruiting', 'IA', 'Cloud', 'Startups', 'Ecuador'
];

// Orígenes (Fuentes)
const sources = [
  'Eventbrite', 'Luma', 'Devpost', 'MLH', 'Coursera', 'edX', 'AWS', 'Google Cloud',
  'Azure', 'OpenAI', 'HuggingFace', 'Startup Grind', 'Techstars', 'Fulbright', 'EPN', 'ESPOL'
];

const modalities = [
  { label: 'Presencial', value: 'presential' },
  { label: 'Virtual / Online', value: 'virtual' }
];
const costs = [
  { label: 'Gratuito', value: 'free' },
  { label: 'De Pago', value: 'paid' }
];
const dates = [
  { label: 'Este Mes', value: 'this-month' },
  { label: 'Próximo Mes', value: 'next-month' },
  { label: 'Próximos 3 Meses', value: 'next-3-months' }
];
---

<aside class="w-full lg:w-72 flex-shrink-0 lg:sticky lg:top-36 z-10 lg:max-h-[calc(100vh-9rem)] overflow-y-auto custom-scrollbar rounded-2xl">

  <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl p-6 backdrop-blur-sm shadow-lg shadow-[var(--color-sim-primary)]/5 transition-colors duration-300">
    <div class="flex items-center justify-between mb-4 sticky top-0 bg-[var(--card-bg)] z-10 py-2">
      <h2 class="text-lg font-bold text-[var(--text-color)] flex items-center gap-2 transition-colors duration-300">
        <svg class="w-5 h-5 text-[var(--color-sim-action)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
        Filtros
      </h2>
      <button id="clear-filters" class="text-xs text-[var(--color-sim-orange)] hover:text-orange-500 transition-colors duration-300 font-semibold hidden">
        Limpiar
      </button>
    </div>

    <button id="apply-filters" class="w-full mb-5 py-2 rounded-lg bg-[var(--color-sim-action)] text-white font-semibold">Aplicar filtros y búsqueda</button>
    <!-- Filtro de Categorías -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Categoría</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {categories.map(category => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="category" value={category} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{category}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Proveedores (Sources) -->
    <details class="group mb-4">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Plataformas</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1 max-h-48 overflow-y-auto custom-scrollbar">
        {sources.map(source => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="source" value={source} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{source}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Temas (Topics) -->
    <details class="group mb-4">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Temáticas</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1 max-h-48 overflow-y-auto custom-scrollbar">
        {topics.map(topic => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="topic" value={topic} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{topic}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Fecha -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Fecha</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {dates.map(date => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="radio" class="peer sr-only filter-input" name="date" value={date.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded-full bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <div class="absolute w-2 h-2 bg-white rounded-full left-1.5 top-1.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300"></div>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{date.label}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Modalidad -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Modalidad</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {modalities.map(mod => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="modality" value={mod.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{mod.label}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Costo -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Costo</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {costs.map(cost => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="cost" value={cost.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{cost.label}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Ciudad -->
    <details class="group mb-2">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">Ubicación</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {cities.map(city => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="city" value={city} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{city}</span>
          </label>
        ))}
      </div>
    </details>

  </div>
</aside>

<style>
  /* Ocultar el marcador nativo del details en navegadores webkit */
  details > summary::-webkit-details-marker {
    display: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.3);
    border-radius: 4px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(location.search);
    const inputs = document.querySelectorAll<HTMLInputElement>('.filter-input');
    inputs.forEach(input => { input.checked = params.getAll(input.name).includes(input.value); });
    const search = document.querySelector<HTMLInputElement>('#global-search');
    if (search) search.value = params.get('q') || '';
    document.querySelector('#clear-search')?.classList.toggle('hidden', !search?.value);
    if (params.get('virtual') === 'true') {
      const virtual = document.querySelector<HTMLInputElement>('input[name="modality"][value="virtual"]');
      if (virtual) virtual.checked = true;
    }
    if (params.get('free') === 'true') {
      const free = document.querySelector<HTMLInputElement>('input[name="cost"][value="free"]');
      if (free) free.checked = true;
    }
    function apply() {
      const query = new URLSearchParams();
      inputs.forEach(input => { if (input.checked) query.append(input.name, input.value); });
      if (search?.value.trim()) query.set('q', search.value.trim().slice(0, 100));
      const size = document.querySelector<HTMLSelectElement>('#page-size')?.value;
      if (size && size !== '12') query.set('size', size);
      query.sort();
      location.assign(location.pathname + (query.size ? '?' + query.toString() : ''));
    }
    document.querySelector('#apply-filters')?.addEventListener('click', apply);
    search?.addEventListener('keydown', event => { if (event.key === 'Enter') apply(); });
    document.querySelector('#clear-search')?.addEventListener('click', () => { if (search) search.value = ''; apply(); });
    document.querySelector('#clear-filters')?.classList.toggle('hidden', !params.size);
    document.querySelector('#clear-filters')?.addEventListener('click', () => location.assign(location.pathname));
    document.querySelector('#page-size')?.addEventListener('change', apply);
    document.querySelector('#prev-page')?.addEventListener('click', () => {
      const previous = sessionStorage.getItem('catalogPrevious');
      if (previous?.startsWith(location.pathname + '?') || previous === location.pathname) location.assign(previous);
      else { params.delete('cursor'); location.assign(location.pathname + '?' + params.toString()); }
    });
    document.querySelector<HTMLElement>('#next-page')?.addEventListener('click', event => {
      const url = (event.currentTarget as HTMLElement).dataset.nextUrl;
      if (url) { sessionStorage.setItem('catalogPrevious', location.pathname + location.search); location.assign(url); }
    });
  });
</script>
