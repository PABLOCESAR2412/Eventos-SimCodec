---
import { filterOptions } from '../../shared/domain';
import { translator, localeForPath } from '../lib/i18n';
const t = translator(localeForPath(Astro.url.pathname));
const cities = filterOptions.city, categories = filterOptions.category, topics = filterOptions.topic, sources = filterOptions.source;
const modalities = [
  { label: 'Presencial', value: 'presential' },
  { label: 'Virtual / Online', value: 'virtual' }
];
const costs = [
  { label: 'Gratuito', value: 'free' },
  { label: 'De Pago', value: 'paid' },
  { label: 'Consultar precio', value: 'unknown' }
];
const dates = [
  { label: 'Este Mes', value: 'this-month' },
  { label: 'Próximo Mes', value: 'next-month' },
  { label: 'Próximos 3 Meses', value: 'next-3-months' }
];
const isCourseView = Astro.url.searchParams.get('view') === 'courses';
const filterKeys = ['category', 'source', 'topic', 'date', 'modality', 'cost', 'city', 'virtual', 'free'];
const activeFilters = filterKeys.reduce((count, key) => count + Astro.url.searchParams.getAll(key).filter(Boolean).length, 0);
---

<aside class="w-full lg:w-72 flex-shrink-0 lg:sticky lg:top-36 z-10 lg:max-h-[calc(100vh-9rem)] overflow-y-auto custom-scrollbar rounded-2xl">

  <details id="catalog-filters" class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl p-4 lg:p-6 backdrop-blur-sm shadow-lg shadow-[var(--color-sim-primary)]/5 transition-colors duration-300 group/filters">
    <summary class="flex min-h-11 items-center justify-between gap-3 cursor-pointer list-none select-none rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-sim-action)]">
      <h2 class="text-lg font-bold text-[var(--text-color)] flex items-center gap-2 transition-colors duration-300">
        <svg class="w-5 h-5 text-[var(--color-sim-action)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
        {t('Filtros')}
      </h2>
      <div class="flex items-center gap-2">
        {activeFilters > 0 && <span class="text-xs font-medium text-[var(--text-color)]">{activeFilters} {t('activos')}</span>}
        <svg aria-hidden="true" class="w-4 h-4 text-[var(--text-color)] transition-transform group-open/filters:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </div>
    </summary>
    <div id="filter-controls" data-lenis-prevent class="pt-4 max-h-[65dvh] overflow-y-auto overscroll-contain custom-scrollbar lg:max-h-none lg:overflow-visible">
    <div class="flex justify-end mb-3">
      <button id="clear-filters" class="min-h-11 px-2 text-sm text-[var(--text-color)] hover:text-[var(--color-sim-action)] transition-colors duration-300 font-semibold hidden">
        {t('Limpiar')}
      </button>
    </div>

    <button id="apply-filters" class="w-full min-h-11 mb-5 py-2 rounded-lg bg-[var(--color-sim-action)] text-white font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sim-action)]">{t('Aplicar filtros y búsqueda')}</button>
    <!-- Filtro de Categorías -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Categoría')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {categories.map(category => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="category" value={category} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(category)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Proveedores (Sources) -->
    <details class="group mb-4">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Plataformas')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1 max-h-48 overflow-y-auto custom-scrollbar">
        {sources.map(source => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="source" value={source} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(source)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Temas (Topics) -->
    <details class="group mb-4">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Temáticas')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1 max-h-48 overflow-y-auto custom-scrollbar">
        {topics.map(topic => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="topic" value={topic} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(topic)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" hidden={isCourseView} />

    <!-- Filtro de Fecha -->
    <details class="group mb-4" open hidden={isCourseView}>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Fecha')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {dates.map(date => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="radio" class="peer sr-only filter-input" name="date" value={date.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded-full bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <div class="absolute w-2 h-2 bg-white rounded-full left-1.5 top-1.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300"></div>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(date.label)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Modalidad -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Modalidad')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {modalities.map(mod => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="modality" value={mod.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(mod.label)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Costo -->
    <details class="group mb-4" open>
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Costo')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {costs.map(cost => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="cost" value={cost.value} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(cost.label)}</span>
          </label>
        ))}
      </div>
    </details>

    <hr class="border-neutral-200 dark:border-neutral-800 my-4" />

    <!-- Filtro de Ciudad -->
    <details class="group mb-2">
      <summary class="flex justify-between items-center font-semibold text-gray-700 dark:text-gray-300 cursor-pointer list-none select-none">
        <span class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">{t('Ubicación')}</span>
        <svg class="w-4 h-4 transition-transform group-open:rotate-180 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </summary>
      <div class="space-y-2 mt-3 pl-1">
        {cities.map(city => (
          <label class="flex items-center gap-3 cursor-pointer group/item">
            <div class="relative flex items-center">
              <input type="checkbox" class="peer sr-only filter-input" name="city" value={city} />
              <div class="w-5 h-5 border border-gray-300 dark:border-[var(--border-color)] rounded bg-white dark:bg-gray-800 peer-checked:bg-[var(--color-sim-action)] peer-checked:border-[var(--color-sim-action)] transition-colors duration-300"></div>
              <svg class="absolute w-3.5 h-3.5 text-white left-0.5 top-0.5 opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover/item:text-[var(--color-sim-action)] transition-colors duration-300">{t(city)}</span>
          </label>
        ))}
      </div>
    </details>

    </div>
  </details>
</aside>

<style>
  /* Ocultar el marcador nativo del details en navegadores webkit */
  details > summary::-webkit-details-marker {
    display: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.3);
    border-radius: 4px;
  }
  .filter-input:focus-visible + div {
    outline: 2px solid var(--color-sim-action);
    outline-offset: 2px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(location.search);
    const filterPanel = document.querySelector<HTMLDetailsElement>('#catalog-filters');
    const desktop = window.matchMedia('(min-width: 1024px)');
    if (filterPanel) {
      filterPanel.open = desktop.matches;
      desktop.addEventListener('change', event => { filterPanel.open = event.matches; });
    }
    const inputs = document.querySelectorAll<HTMLInputElement>('.filter-input');
    inputs.forEach(input => { input.checked = params.getAll(input.name).includes(input.value); });
    const search = document.querySelector<HTMLInputElement>('#global-search');
    if (search) search.value = params.get('q') || '';
    document.querySelector('#clear-search')?.classList.toggle('hidden', !search?.value);
    if (params.get('virtual') === 'true') {
      const virtual = document.querySelector<HTMLInputElement>('input[name="modality"][value="virtual"]');
      if (virtual) virtual.checked = true;
    }
    if (params.get('free') === 'true') {
      const free = document.querySelector<HTMLInputElement>('input[name="cost"][value="free"]');
      if (free) free.checked = true;
    }
    function apply() {
      const query = new URLSearchParams();
      if (params.get('view') === 'courses') query.set('view', 'courses');
      inputs.forEach(input => { if (input.checked && !(query.has('view') && input.name === 'date')) query.append(input.name, input.value); });
      if (search?.value.trim()) query.set('q', search.value.trim().slice(0, 100));
      const size = document.querySelector<HTMLSelectElement>('#page-size')?.value;
      if (size && size !== '12') query.set('size', size);
      query.sort();
      location.assign(location.pathname + (query.size ? '?' + query.toString() : ''));
    }
    document.querySelector('#apply-filters')?.addEventListener('click', apply);
    search?.addEventListener('keydown', event => { if (event.key === 'Enter') apply(); });
    document.querySelector('#clear-search')?.addEventListener('click', () => { if (search) search.value = ''; apply(); });
    const hasFilters = [...params.keys()].some(key => !['view', 'size', 'cursor'].includes(key));
    document.querySelector('#clear-filters')?.classList.toggle('hidden', !hasFilters);
    document.querySelector('#clear-filters')?.addEventListener('click', () => location.assign(location.pathname + (params.get('view') === 'courses' ? '?view=courses' : '')));
    document.querySelector('#page-size')?.addEventListener('change', apply);
  });
</script>
