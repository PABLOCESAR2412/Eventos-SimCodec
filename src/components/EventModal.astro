---
import { translator, localeForPath } from '../lib/i18n';
const t = translator(localeForPath(Astro.url.pathname));
---
    <!-- Modal Component -->
    <dialog id="event-modal" aria-labelledby="modal-title" data-lenis-prevent class="fixed inset-0 items-center justify-center p-4 text-[var(--text-color)]">
      <div id="modal-backdrop" aria-hidden="true" class="absolute inset-0 bg-black/50 dark:bg-black/80 backdrop-blur-sm cursor-pointer transition-colors duration-300"></div>
      <div class="relative bg-[var(--card-bg)] border border-[var(--border-color)] rounded-2xl w-full max-w-2xl max-h-[calc(100dvh-2rem)] overflow-y-auto overscroll-contain shadow-2xl" id="modal-content">
        <div class="sticky top-0 z-10 flex justify-end h-0">
          <button id="close-modal" type="button" autofocus class="relative top-4 right-4 min-w-11 min-h-11 flex items-center justify-center bg-white/90 dark:bg-black/80 text-gray-800 dark:text-white hover:bg-white dark:hover:bg-black p-2 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-sim-action)]" aria-label={t('Cerrar detalles')}>
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <div id="modal-image-container" class="relative h-64 bg-gray-100 dark:bg-gray-800 transition-colors duration-300">
          <img id="modal-img" src="/loading_logo_dark.png" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
        </div>
        <div id="modal-details" class="p-6 sm:p-8">
          <div class="flex gap-3 mb-4">
            <span id="modal-city" class="text-xs font-semibold uppercase text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-400/10 px-2.5 py-1 rounded-md border border-blue-200 dark:border-transparent"></span>
            <span id="modal-price" class="text-xs font-semibold uppercase px-2.5 py-1 rounded-md"></span>
          </div>
          <h2 id="modal-title" class="text-3xl font-bold text-[var(--text-color)] mb-2 leading-tight transition-colors duration-300"></h2>
          <p id="modal-date" class="text-sm text-gray-600 dark:text-gray-400 mb-6 font-medium capitalize-first transition-colors duration-300"></p>
          <p id="modal-desc" class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6 transition-colors duration-300"></p>

          <div class="bg-gray-100 dark:bg-gray-800/50 rounded-lg p-5 mb-8 border border-gray-300 dark:border-[var(--border-color)] transition-colors duration-300">
            <h3 class="text-sm font-bold text-[var(--text-color)] uppercase tracking-wider mb-3 flex items-center gap-2 transition-colors duration-300">
              <svg class="w-4 h-4 text-[var(--color-sim-brand)] transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span id="modal-instructions-title">{t('Pasos para Participar')}</span>
            </h3>
            <ol id="modal-instructions-list" class="list-decimal list-inside space-y-2 text-sm text-gray-700 dark:text-gray-300 transition-colors duration-300">
              <!-- Dynamically injected via JS -->
            </ol>
          </div>

          <div class="flex justify-end pt-4 border-t border-[var(--border-color)]">
            <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="bg-[var(--color-sim-action)] hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg shadow-lg shadow-[var(--color-sim-action)]/20 transition-all hover:scale-105 flex items-center gap-2">
              <span id="modal-btn-text">{t('Ir al Sitio Web')}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </dialog>

<script>
  import { initEventModal } from '../lib/event-modal';
  initEventModal();
</script>
  <style>
    #event-modal {
      display: none;
      margin: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border: 0;
      background: transparent;
    }
    #event-modal[open] {
      display: flex;
    }
    #event-modal::backdrop {
      background: transparent;
    }
    #modal-details {
      overflow-wrap: anywhere;
    }
    #modal-details[data-without-image] {
      padding-top: 5rem;
    }

  </style>